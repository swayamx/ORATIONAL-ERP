{
  "name": "orational-operations-erp",
  "version": "1.0.0",
  "description": "ORATIONAL - Enterprise Operations Platform & Resource Planning",
  "scripts": {
    "start": "npx serve .",
    "build": "echo 'ORATIONAL ready for deployment'",
    "setup": "npm --prefix backend install && npm --prefix frontend install && npm --prefix backend run db:setup",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "test:concurrency": "npm --prefix backend run test:concurrency",
    "seed": "npm --prefix backend run db:seed"
  },
  "keywords": [
    "erp",
    "inventory-management",
    "work-orders",
    "stock-transfer",
    "concurrency-control",
    "orational"
  ],
